# Android / Gradle local configuration
local.properties
*.local.properties
.gradle/
**/build/

# Generated Android packages belong in CI artifacts/releases, not source history
*.apk
*.aab

# Signing credentials
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# Environment / secret files
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
private/
credentials/

# Google/Firebase private service credentials
*service-account*.json
*service_account*.json
*credentials*.json

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Source project archives are intentionally retained while the app still uses
# the legacy ZIP-based source seed. Generated APKs are published by CI instead.
